{
  "name": "cyber-news-worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "mkdir -p ../frontend/dist && wrangler dev",
    "build": "XDG_CONFIG_HOME=/tmp wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cyber-japanese-news/shared": "workspace:*",
    "fast-xml-parser": "^5.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260713.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}
